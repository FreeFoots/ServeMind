{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServeMind",
  "version": "0.1.0",
  "identifier": "com.servemind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5317",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ServeMind", "width": 1440, "height": 900, "minWidth": 980, "minHeight": 680, "decorations": true, "transparent": false, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
